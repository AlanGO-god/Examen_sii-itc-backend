PORT=4000
SII_API_BASE_URL=https://sii.celaya.tecnm.mx/api
CORS_ORIGIN=http://localhost:5173
# Prefijo del nombre de tu proyecto en Vercel (acepta previews y producción)
CORS_VERCEL_PREFIX=examen-sii-itc-frontend
MONITOR_INTERVAL_MS=120000

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TUTOR_CALIFICACION_MINIMA=80

# Firma la cookie de sesión de este backend. Mínimo 32 caracteres.
# Genera uno con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Opcional: student_key de los administradores iniciales, separados por coma.
# Tu student_key aparece en la respuesta de GET /api/session al iniciar sesión.
ADMIN_STUDENT_KEYS=
